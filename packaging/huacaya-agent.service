[Unit]
Description=huacaya agent: this machine's panels for remote huacaya dashboards
Documentation=file:///usr/share/doc/huacaya/README.md
After=network-online.target
Wants=network-online.target

[Service]
# No account to create: systemd allocates one. The journal group lets it follow the llama-server log.
DynamicUser=yes
SupplementaryGroups=systemd-journal
# The token clients must send; the file stays root-only, the service reads a private copy.
LoadCredential=token:/etc/huacaya/agent-token
ExecStart=/usr/bin/huacaya agent --listen 0.0.0.0:9099 --token-file ${CREDENTIALS_DIRECTORY}/token
Restart=on-failure
RestartSec=5
# Read-only by nature: it only reads /proc, /sys, the journal and statvfs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
